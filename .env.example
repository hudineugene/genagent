# Ключ шифрования сессий, 32+ символа (npm run setup генерирует его сам)
SESSION_PASSWORD=
# Ключи провайдеров моделей — достаточно тех, чьи модели используете
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Первый администратор (создаётся командой npm run setup, пароль генерируется)
SEED_ADMIN_EMAIL=admin@studio.local
SEED_ADMIN_PASSWORD=
